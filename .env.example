# Provider API keys (secrets — never commit real values).
# Leave these commented unless you have a key: an exported empty value overrides the
# non-empty placeholders in application.yml and can break zero-key startup.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Local provider defaults (Ollama — no key required)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Cloud model defaults
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ANTHROPIC_CHAT_MODEL=claude-3-5-haiku-20241022

# Optional tunables (uncomment to override source/YAML defaults)
# AI_EVAL_MAX_RUNS=100
# AI_EVAL_GENERATION_CONCURRENCY=4
# TRACE_DUCKDB_URL=jdbc:duckdb:${HOME}/.spring-ai-apps/ai-observability/traces.duckdb
# TRACE_DUCKDB_RETENTION_DAYS=7
# AI_OBSERVABILITY_SERVICE_NAME=ai-observability
# SERVER_PORT=8080

# Postgres / PGVector (Docker Compose reads these; export them to the JVM separately)
# Set a non-default password before running `docker compose up -d`.
SPRING_DATASOURCE_DB=spring_ai_pgvector
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/spring_ai_pgvector
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change-me

# Opt-in `security` profile (local hardening only; not production authentication)
AI_SECURITY_API_KEY=local-demo-key
AI_SECURITY_USERNAME=demo
AI_SECURITY_PASSWORD=local-demo-password
# Comma-separated origins; empty denies all cross-origin requests in the security profile.
AI_SECURITY_ALLOWED_ORIGINS=
AI_SECURITY_RATE_LIMIT=60

# Jev / System One decision model
# Only set one key alias. An explicitly empty first alias stops fallthrough to the next;
# a blank active key is logged at startup and sends no Authorization header.
# JEV_API_KEY=
# TYPESAFE_API_KEY=
# SYSTEMONE_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest
