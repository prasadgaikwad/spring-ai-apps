# Provider API keys (secrets — never commit real values)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Local provider defaults (Ollama — no key required)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Cloud model defaults
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ANTHROPIC_CHAT_MODEL=claude-3-5-haiku-20241022

# Postgres / PGVector
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/spring_ai_pgvector
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
